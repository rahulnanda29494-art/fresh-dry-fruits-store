DATABASE_URL="postgresql://fdf:fdf_dev_pw@localhost:5432/fresh_dry_fruits"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000

# Razorpay test-mode keys — power UPI + debit/credit card checkout. Until both
# are set, UPI/card record a simulated (test-mode) payment; COD always works.
# Get free test keys at https://dashboard.razorpay.com/app/keys (Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SMTP for password-reset emails. Unset in dev → the reset link is shown
# on-screen instead of emailed. Gmail: host smtp.gmail.com, port 465, user =
# your address, pass = a Google App Password (myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional explicit base URL for links in emails (else derived from the request)
# APP_URL=https://your-app.onrender.com
