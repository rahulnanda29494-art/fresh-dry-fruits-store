generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  createdAt        DateTime  @default(now())
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  orders           Order[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  price       Int
  oldPrice    Int
  rating      Float
  reviews     Int
  weight      String
  badge       String?
  organic     Boolean  @default(false)
  origin      String
  blurb       String
  benefits    String[]
  nutrition   Json
  image       String
  bestSeller  Boolean  @default(false)
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  orderItems  OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNo         String      @unique
  // Unguessable lookup key for the confirmation screen. orderNo is short and
  // user-visible, so it must never be the thing that authorises a read.
  publicToken     String      @unique
  user            User?       @relation(fields: [userId], references: [id])
  userId          String?
  guestEmail      String?
  guestName       String?
  shippingAddress Json
  paymentMethod   String
  paymentStatus   String      @default("pending")
  stripePaymentIntentId String?   // legacy (Stripe) — retained for older rows
  razorpayOrderId       String?
  razorpayPaymentId     String?
  couponCode      String?
  subtotal        Int
  discount        Int         @default(0)
  shipping        Int         @default(0)
  total           Int
  status          String      @default("confirmed")
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  qty       Int
  unitPrice Int
}
